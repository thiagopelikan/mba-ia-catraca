<%- include('../partials/head', { title }) %>
<h1><%= event.name %></h1>
<ul class="ficha">
  <li><strong>Data:</strong> <%= event.startsAtLabel %></li>
  <li><strong>Local:</strong> <%= event.venue %></li>
  <li><strong>Preço:</strong> <%= event.priceLabel %></li>
</ul>

<section id="compra">
<% if (locals.error) { %><p class="message error"><%= error %></p><% } %>
<% if (event.available === 0) { %>
  <p class="message"><strong>Ingressos esgotados</strong></p>
<% } else { %>
  <p>Vagas disponíveis: <%= event.available %></p>
  <% if (locals.user && locals.user.role === 'participant') { %>
  <form method="post" action="/eventos/<%= event.id %>/comprar">
    <label>Número do cartão
      <input type="text" name="cardNumber" inputmode="numeric" autocomplete="off" maxlength="16" required>
    </label>
    <p class="ajuda">Pagamento simulado: cartão de 16 dígitos com final 0001 é aprovado, e com final 0002 é recusado, em poucos segundos; finais 0003 (aprovado) e 0004 (recusado) levam cerca de 30 segundos. Qualquer outro final é recusado.</p>
    <button type="submit">Comprar ingresso</button>
  </form>
  <% } else if (locals.user) { %>
  <p>Compras são feitas com uma conta de participante</p>
  <% } else { %>
  <p><a href="/entrar?next=/eventos/<%= event.id %>">Entre para comprar</a></p>
  <% } %>
<% } %>
</section>

<p class="voltar"><a href="/">Voltar para a vitrine</a></p>
<%- include('../partials/foot') %>
