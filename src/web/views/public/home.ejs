<%- include('../partials/head', { title }) %>
<h1>Eventos</h1>
<p class="chamada">Shows em bar, workshops e meetups. Um ingresso por compra.</p>
<% if (events.length === 0) { %>
<p>Nenhum evento à venda no momento.</p>
<% } else { %>
<table class="tiras eventos">
  <thead><tr><th>Evento</th><th>Data</th><th>Local</th><th>Preço</th><th>Ingressos</th></tr></thead>
  <tbody>
  <% for (const event of events) { %>
    <tr<% if (event.available === 0) { %> class="esgotado"<% } %>>
      <td><a href="/eventos/<%= event.id %>"><%= event.name %></a></td>
      <td><%= event.startsAtLabel %></td>
      <td><%= event.venue %></td>
      <td><%= event.priceLabel %></td>
      <td><% if (event.available === 0) { %>Ingressos esgotados<% } else { %>Vagas disponíveis: <%= event.available %><% } %></td>
    </tr>
  <% } %>
  </tbody>
</table>
<% } %>
<%- include('../partials/foot') %>
