<%- include('../partials/head', { title }) %>
<h1>Meus eventos</h1>
<p><a class="acao" href="/organizador/eventos/novo">Novo evento</a></p>
<% if (events.length === 0) { %>
<p>Você ainda não tem eventos.</p>
<% } else { %>
<table class="lista">
  <thead><tr><th>Nome</th><th>Data</th><th>Status</th></tr></thead>
  <tbody>
  <% for (const event of events) { %>
    <tr>
      <td><a href="/organizador/eventos/<%= event.id %>"><%= event.name %></a></td>
      <td><%= event.startsAtLabel %></td>
      <td><%= event.statusLabel %></td>
    </tr>
  <% } %>
  </tbody>
</table>
<% } %>
<%- include('../partials/foot') %>
